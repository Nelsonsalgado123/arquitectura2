classDiagram
    %% ===== API Festivos (MongoDB) =====
    class Festivo {
        <<Documento MongoDB>>
        -ObjectId _id
        -int dia
        -int mes
        -String nombre
        -int idTipo
        -int diasPascua
    }

    class TipoFestivo {
        <<enumeration>>
        1 Fijo
        2 Ley de Puente festivo
        3 Basado en domingo de Pascua
        4 Pascua y Ley de Puente festivo
    }

    %% ===== API Calendario (PostgreSQL) =====
    class Tipo {
        -int id
        -String tipo
        +getId() int
        +getTipo() String
    }

    class Calendario {
        -int id
        -Date fecha
        -Tipo tipo
        -String descripcion
        +getId() int
        +getFecha() Date
        +getTipo() Tipo
        +getDescripcion() String
    }

    class FestivoDto {
        <<DTO - respuesta API Festivos>>
        -String festivo
        -String fecha
    }

    Festivo --> TipoFestivo : idTipo
    Calendario --> Tipo : clasificado por
    FestivoDto ..> Festivo : se calcula a partir de
    Calendario ..> FestivoDto : usa para marcar festivos
